{
  "name": "pageparcel",
  "version": "0.3.0",
  "description": "Local-first web capture with screenshots, Markdown, metadata, and integrity hashes.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "Andrew Greene <https://github.com/apcar>",
  "repository": {
    "type": "git",
    "url": "https://github.com/apcar/PageParcel.git"
  },
  "homepage": "https://github.com/apcar/PageParcel#readme",
  "bugs": "https://github.com/apcar/PageParcel/issues",
  "keywords": [
    "chrome-extension",
    "screenshot",
    "web-capture",
    "markdown",
    "local-first",
    "provenance"
  ],
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run icons && tsc --noEmit && vite build",
    "package": "npm run build"
  },
  "dependencies": {
    "defuddle": "0.19.3",
    "fflate": "0.8.3",
    "preact": "^10.29.8",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.9",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  }
}
